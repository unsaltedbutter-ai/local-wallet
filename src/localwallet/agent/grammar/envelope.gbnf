# envelope.gbnf — v0 intent envelope grammar (llama.cpp GBNF)
#
# Constrains model decoding to EXACTLY the canonical envelope contract v0
# (extended in Phase 1, Phase 2, Phase 3 and Phase 4 — see
# docs/adr/0002-envelope-spec.md, docs/adr/0013-confirm-gate.md and the
# ADR-0013 Phase 3 amendment):
#
#   {"v": 0, "intent": <closed enum>, "params": {...}}
#
#   v        : integer 0 exactly
#   intent   : closed enum of the twelve names
#   params   : required object, whose shape depends on intent:
#                respond     -> {"text": string}
#                clarify     -> {"question": string}
#                get_balance -> {}
#                get_history -> {} or {"limit": <1-3 digit int>}
#                               (semantic bound 1..100 at the schema layer;
#                                omitted -> handler default 20)
#                get_utxos   -> {}
#                new_address -> {} or {"branch": "0"|"1"}
#                               (0 = receive chain default, 1 = change)
#                create_tx   -> {"recipient": string} then EXACTLY ONE of
#                               {"amount_sats": <int>} |
#                               {"amount_usd": <decimal number>},
#                               then AT MOST ONE of
#                               {"fee_target": fast|medium|slow} |
#                               {"fee_rate_sat_vb": <int>} (mutually
#                               exclusive fee knobs, TCK-FEE-002; semantic
#                               bound 1..10000 at the schema layer)
#                confirm_tx  -> {"tx_ref": string}
#                sign_tx     -> {"tx_ref": string} then OPTIONAL
#                               {"signer": "file"|"hwi"}
#                               (omitted -> handler default signer policy)
#                broadcast_tx -> {"tx_ref": string}
#                tx_status   -> {"txid": <exactly 64 lowercase hex chars>}
#                               (the grammar pins the URL-path-safe charset;
#                                the schema/rule layer re-checks it)
#                node_status -> {} (the model emits nothing else; the
#                               dispatcher owns all data)
#
# KEY ORDER: STRICT. The model must emit keys in order v, intent, params.
# This is simpler for a small model and removes any ambiguity in the
# intent->params pairing. The chosen intent branch is coupled to its params
# shape at the grammar level, so a mismatched combination (e.g. intent
# "respond" with params {}) is syntactically impossible, not just caught later.
#
# STRINGS: conservative JSON string rule — standard JSON escapes only
# (\" \\ \/ \b \f \n \r \t, and \uXXXX), no raw control characters
# (\x00-\x1f) and no raw quote or backslash.
#
# WHITESPACE: optional ASCII whitespace is allowed around tokens so the model
# can emit readable JSON without being penalized.
#
# NUMBERS (create_tx): JSON-consistent integers/decimals only.
#   - amount_sats: no leading zeros (a single "0" is legal JSON and admitted
#     here; the schema rejects it below its 546 floor), up to 16 digits —
#     i.e. every syntactically possible value up to ~1e16, comfortably
#     covering the semantic ceiling (21_000_000_000_000_000 sats). Values
#     between ~9.99e15 and the schema ceiling are grammar-rejected: the
#     narrowing direction only restricts what the model can emit, never
#     admits an envelope the schema would reject.
#   - amount_usd: digits with an optional fractional part (>= 1 digit after
#     the "."), no exponent notation. Exponent forms (e.g. 1e2) are
#     schema-legal JSON numbers but grammar-rejected — the same safe
#     narrowing direction as above; the model emits plain decimals.
#     The integer form ("10" for 10.00 USD) is admitted.
#   - fee_rate_sat_vb: plain integer sat/vB, no leading zeros, no sign, no
#     exponent (a single "0" admitted so the schema floor rejects it —
#     same narrowing style as sats-int).
#
# CROSS-REFERENCE: this grammar maps 1:1 to the pydantic envelope schema v0
# and MUST be updated together with it (docs/adr/0002-envelope-spec.md and
# docs/adr/0013-confirm-gate.md).
#
# PARSER DIALECT (TCK-P6-004): llama.cpp's vendored GBNF parser (the one
# compiled into llama-cpp-python) restricts rule NAMES to [A-Za-z0-9-] (no
# underscores — its isword() accepts letters, digits and '-'; an underscore
# ends the name and the next token must be '::=' or a newline) and terminates
# every rule body at a NEWLINE (a body may NOT be continued across lines with
# a leading '|'). Both idioms are legal in the wider GBNF literature and were
# used in earlier revisions of this file, but the installed wheel rejects them
# at generate-time grammar load (the vendored parser prints
# "parse: error parsing grammar: ..." and hands llama_sampler_chain_add a NULL
# grammar, which then crashes the model run). So every rule below is written
# as a SINGLE-LINE body with dash-separated rule names. This is a pure
# DIALECT translation: the accepted envelope LANGUAGE is unchanged — only bare
# rule identifiers were underscore->dash renamed and multi-line bodies joined
# onto one line (GBNF sequences are whitespace-insensitive between symbols).
# The quoted string literals are byte-for-byte identical, so intent values and
# JSON keys keep their underscores (e.g. the literal "get_balance") — a rule
# NAME is only ever a bare identifier, never a quoted literal. The drift pin
# (tests/test_grammar_conformance.py) enforces this dialect and parses the file
# through the installed parser so a regression fails loudly.

# Root rule: exactly one envelope (with optional trailing whitespace).
root ::= envelope ws

# A complete envelope. Opening brace, v=0, then an intent body which carries
# the intent key, its params, and closes the object. Strict key order; the
# only keys allowed are v, intent, params — no extras.
envelope ::= "{" ws "\"v\"" ws ":" ws "0" ws "," ws intent-body

# Each intent branch carries its exact params shape and closes the params
# object and the envelope. This couples intent -> params at decode time.
intent-body ::= respond | clarify | get-balance | get-history | get-utxos | new-address | create-tx | confirm-tx | sign-tx | broadcast-tx | tx-status | node-status

# intent "respond" -> params {"text": string}
respond ::= "\"intent\"" ws ":" ws "\"respond\"" ws "," ws "\"params\"" ws ":" ws "{" ws "\"text\"" ws ":" ws string ws "}" ws "}" ws

# intent "clarify" -> params {"question": string}
clarify ::= "\"intent\"" ws ":" ws "\"clarify\"" ws "," ws "\"params\"" ws ":" ws "{" ws "\"question\"" ws ":" ws string ws "}" ws "}" ws

# intent "get_balance" -> params {} (empty object)
get-balance ::= "\"intent\"" ws ":" ws "\"get_balance\"" ws "," ws "\"params\"" ws ":" ws "{" ws "}" ws "}" ws

# intent "get_history" -> params {} OR {"limit": <1-3 digit int>}
# The optional key is expressed as a top-level alternation between the two
# complete params objects (never an optional-token sequence), so key order
# stays strict and no other key can slip in.
get-history ::= "\"intent\"" ws ":" ws "\"get_history\"" ws "," ws "\"params\"" ws ":" ws params-history

params-history ::= "{" ws "}" ws "}" ws | "{" ws "\"limit\"" ws ":" ws limit-int ws "}" ws "}" ws

# limit: 1..999 syntactic (1-3 digits, no leading zero); the semantic
# 1..100 business bound is enforced at the schema layer (layer 2/3).
limit-int ::= [1-9] [0-9]? [0-9]?

# intent "get_utxos" -> params {} (empty object)
get-utxos ::= "\"intent\"" ws ":" ws "\"get_utxos\"" ws "," ws "\"params\"" ws ":" ws "{" ws "}" ws "}" ws

# intent "new_address" -> params {} OR {"branch": "0"|"1"}
new-address ::= "\"intent\"" ws ":" ws "\"new_address\"" ws "," ws "\"params\"" ws ":" ws params-new-address

params-new-address ::= "{" ws "}" ws "}" ws | "{" ws "\"branch\"" ws ":" ws branch-digit ws "}" ws "}" ws

# branch: single digit, 0 (receive chain) or 1 (change chain).
branch-digit ::= "0" | "1"

# intent "create_tx" -> params {"recipient": string, (amount_sats | amount_usd)[, (fee_target | fee_rate_sat_vb)]}
# Keys in FIXED order: recipient first, then exactly one amount key
# (alternation at the amount-pair level — both amounts at once is
# syntactically impossible), then an OPTIONAL fee-knob tail. The optional
# tail is a named three-branch rule (bare / fee_target / fee_rate_sat_vb)
# so no other key can slip in, at most ONE fee knob can appear, and the
# order recipient < amount < fee-knob stays strict.
create-tx ::= "\"intent\"" ws ":" ws "\"create_tx\"" ws "," ws "\"params\"" ws ":" ws params-create-tx

params-create-tx ::= "{" ws recipient-kv ws "," ws amount-pair ws create-tx-tail

recipient-kv ::= "\"recipient\"" ws ":" ws string

amount-pair ::= amount-sats-kv | amount-usd-kv

amount-sats-kv ::= "\"amount_sats\"" ws ":" ws sats-int

amount-usd-kv ::= "\"amount_usd\"" ws ":" ws usd-num

# The two fee knobs are MUTUALLY EXCLUSIVE by alternation (TCK-FEE-002):
# a tail is either a fee_target, or a fee_rate_sat_vb, or nothing — both
# at once is syntactically impossible (the schema layer re-checks).
create-tx-tail ::= "}" ws "}" ws | "," ws fee-target-kv ws "}" ws "}" ws | "," ws fee-rate-kv ws "}" ws "}" ws

fee-target-kv ::= "\"fee_target\"" ws ":" ws fee-target

# fee target: the closed enum, quoted literals only.
fee-target ::= "\"fast\"" | "\"medium\"" | "\"slow\""

fee-rate-kv ::= "\"fee_rate_sat_vb\"" ws ":" ws fee-rate-int

# fee rate: JSON integer sat/vB, 1-5 digits no leading zero (a single "0"
# is legal JSON and admitted here; the schema rejects it below its 1
# floor), syntactic cap 99_999; the semantic bound 1..10_000
# (MAX_FEE_RATE_SAT_VB) is enforced at the schema layer — the same
# grammar-loose / schema-tight split as limit-int and sats-int.
fee-rate-int ::= [1-9] [0-9]{0,4} | "0"

# amount_sats: JSON integer, no leading zeros (single "0" allowed — the
# schema rejects it below the 546 floor), up to 16 digits. The semantic
# bound 546..21_000_000_000_000_000 is enforced at the schema layer.
sats-int ::= [1-9] [0-9]{0,15} | "0"

# amount_usd: JSON decimal WITHOUT exponent notation — integer part ("0" or
# nonzero-start) with an optional fractional part of >= 1 digit. Exponent
# forms (1e2) are schema-legal but grammar-rejected (conservative narrowing:
# only restricts model freedom, never admits an invalid envelope).
usd-num ::= ("0" | [1-9] [0-9]*) ("." [0-9] [0-9]*)?

# intent "confirm_tx" -> params {"tx_ref": string}
confirm-tx ::= "\"intent\"" ws ":" ws "\"confirm_tx\"" ws "," ws "\"params\"" ws ":" ws "{" ws "\"tx_ref\"" ws ":" ws string ws "}" ws "}" ws

# intent "sign_tx" -> params {"tx_ref": string[, "signer": "file"|"hwi"]}
# Keys in FIXED order: tx_ref first, then an OPTIONAL signer tail (a named
# two-branch rule, mirroring the create_tx tail, so no other key can slip
# in). Omitted signer -> the handler applies its default signer policy.
sign-tx ::= "\"intent\"" ws ":" ws "\"sign_tx\"" ws "," ws "\"params\"" ws ":" ws params-sign-tx

params-sign-tx ::= "{" ws "\"tx_ref\"" ws ":" ws string ws sign-tx-tail

sign-tx-tail ::= "}" ws "}" ws | "," ws "\"signer\"" ws ":" ws signer-enum ws "}" ws "}" ws

# signer: the closed enum, quoted literals only (device handoff policy is
# the handler's decision; the model may only name one of these two).
signer-enum ::= "\"file\"" | "\"hwi\""

# intent "broadcast_tx" -> params {"tx_ref": string}
broadcast-tx ::= "\"intent\"" ws ":" ws "\"broadcast_tx\"" ws "," ws "\"params\"" ws ":" ws "{" ws "\"tx_ref\"" ws ":" ws string ws "}" ws "}" ws

# intent "tx_status" -> params {"txid": "<exactly 64 lowercase hex chars>"}
# The txid is interpolated into a request URL path by the chain layer, so
# the grammar pins the injection-safe charset: lowercase hex only, exactly
# 64 characters (bounded repetition) between JSON string quotes. The
# schema/rule layer re-checks the same shape for non-grammar producers.
tx-status ::= "\"intent\"" ws ":" ws "\"tx_status\"" ws "," ws "\"params\"" ws ":" ws "{" ws "\"txid\"" ws ":" ws "\"" hex-txid "\"" ws "}" ws "}" ws

# txid: exactly 64 lowercase hex characters ([0-9a-f]{64}). Uppercase is
# deliberately grammar-rejected: the lowercase-only contract keeps quoted
# txids verbatim-comparable and URL-safe without normalization.
hex-txid ::= [0-9a-f]{64}

# intent "node_status" -> params {} (empty object)
# The model emits nothing else; the dispatcher owns all data (detect +
# doctor guidance). Any key here is syntactically impossible.
node-status ::= "\"intent\"" ws ":" ws "\"node_status\"" ws "," ws "\"params\"" ws ":" ws "{" ws "}" ws "}" ws

# Conservative JSON string: any char except quote, backslash, and control
# chars (\x00-\x1f), OR a valid escape sequence. No raw control characters.
string ::= "\"" ([^"\\\x00-\x1f] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F]{4}))* "\""

# Optional ASCII whitespace.
ws ::= ([ \t\n] ws)?
